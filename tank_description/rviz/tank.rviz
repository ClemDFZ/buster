Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      TF Prefix: ""
    - Class: rviz_default_plugins/RobotModel
      Name: GhostCmd
      Enabled: true
      Description Topic:
        Value: /cmd/robot_description
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 0.35
      TF Prefix: ""
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Show Axes: true
      Show Names: false
      Marker Scale: 0.3
    - Class: rviz_default_plugins/MarkerArray
      Name: VizMarkers
      Enabled: true
      Topic:
        Value: /viz/markers
        Depth: 5
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Odometry
      Name: Odom
      Enabled: true
      Topic:
        Value: /odom
        Depth: 5
        Reliability Policy: Reliable
      Keep: 50
      Shape: Arrow
      Position Tolerance: 0.05
      Angle Tolerance: 0.05
    - Class: rviz_default_plugins/Image
      Name: CSI
      Enabled: true
      Topic:
        Value: /csi_cam/image_raw
        Depth: 5
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/Image
      Name: Color
      Enabled: false
      Topic:
        Value: /camera/camera/color/image_raw
        Depth: 5
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/Image
      Name: Depth
      Enabled: false
      Topic:
        Value: /camera/camera/depth/image_rect_raw
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/PointCloud2
      Name: DepthPoints
      Enabled: false
      Topic:
        Value: /camera/camera/depth/color/points
        Reliability Policy: Best Effort
      Size (m): 0.01
      Style: Points
      Color Transformer: AxisColor
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: false
      Topic:
        Value: /map
      Alpha: 0.7
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3
      Focal Point:
        X: 0
        Y: 0
        Z: 0.2
      Name: Current View
      Pitch: 0.4
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
